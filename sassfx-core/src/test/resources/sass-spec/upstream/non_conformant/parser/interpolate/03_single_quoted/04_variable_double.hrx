<===> 04_variable_double/input.scss
$input: 'squoted';
.result {
  output: #{#{$input}};
  output: #{"[#{$input}]"};
  output: #{"#{$input}"};
  output: #{'#{$input}'};
  output: #{"['#{$input}']"};
}

<===> 04_variable_double/output.css
.result {
  output: squoted;
  output: [squoted];
  output: squoted;
  output: squoted;
  output: ['squoted'];
}
