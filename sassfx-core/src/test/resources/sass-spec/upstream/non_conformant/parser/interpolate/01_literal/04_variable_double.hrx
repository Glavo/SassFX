<===> 04_variable_double/input.scss
$input: literal;
.result {
  output: #{#{$input}};
  output: #{"[#{$input}]"};
  output: #{"#{$input}"};
  output: #{'#{$input}'};
  output: #{"['#{$input}']"};
}

<===> 04_variable_double/output.css
.result {
  output: literal;
  output: [literal];
  output: literal;
  output: literal;
  output: ['literal'];
}
