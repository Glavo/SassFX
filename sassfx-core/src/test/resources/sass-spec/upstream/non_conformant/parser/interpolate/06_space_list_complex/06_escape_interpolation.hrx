<===> 06_escape_interpolation/input.scss
$input: gamme "'"delta"'";
.result {
  output: "[\#{gamme "'"delta"'"}]";
  output: "\#{gamme "'"delta"'"}";
  output: '\#{gamme "'"delta"'"}';
  output: "['\#{gamme "'"delta"'"}']";
}

<===> 06_escape_interpolation/output.css
.result {
  output: "[#{gamme " '"delta"' "}]";
  output: "#{gamme " '"delta"' "}";
  output: '#{gamme "' "delta" '"}';
  output: "['#{gamme " '"delta"' "}']";
}
