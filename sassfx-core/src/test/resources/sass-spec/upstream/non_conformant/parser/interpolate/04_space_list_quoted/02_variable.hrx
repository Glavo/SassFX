<===> 02_variable/input.scss
$input: "alpha" 'beta';
.result {
  output: $input;
  output: #{$input};
  output: "[#{$input}]";
  output: "#{$input}";
  output: '#{$input}';
  output: "['#{$input}']";
}

<===> 02_variable/output.css
.result {
  output: "alpha" "beta";
  output: alpha beta;
  output: "[alpha beta]";
  output: "alpha beta";
  output: "alpha beta";
  output: "['alpha beta']";
}
