<===> 03_inline_double/input.scss
.result {
  output: #{#{gamme "'"delta"'"}};
  output: #{"[#{gamme "'"delta"'"}]"};
  output: #{"#{gamme "'"delta"'"}"};
  output: #{'#{gamme "'"delta"'"}'};
  output: #{"['#{gamme "'"delta"'"}']"};
}

<===> 03_inline_double/output.css
.result {
  output: gamme ' delta ';
  output: [gamme ' delta '];
  output: gamme ' delta ';
  output: gamme ' delta ';
  output: ['gamme ' delta ''];
}
