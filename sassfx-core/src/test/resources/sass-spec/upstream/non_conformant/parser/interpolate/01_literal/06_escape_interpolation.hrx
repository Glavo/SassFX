<===> 06_escape_interpolation/input.scss
$input: literal;
.result {
  output: "[\#{literal}]";
  output: "\#{literal}";
  output: '\#{literal}';
  output: "['\#{literal}']";
}

<===> 06_escape_interpolation/output.css
.result {
  output: "[#{literal}]";
  output: "#{literal}";
  output: "#{literal}";
  output: "['#{literal}']";
}
