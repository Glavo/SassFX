<===> 01_inline/input.scss
.result {
  output: "["',foo   ,   '"]"    "bar";
  output: #{"["',foo   ,   '"]"    "bar"};
  output: "[#{"["',foo   ,   '"]"    "bar"}]";
  output: "#{"["',foo   ,   '"]"    "bar"}";
  output: '#{"["',foo   ,   '"]"    "bar"}';
  output: "['#{"["',foo   ,   '"]"    "bar"}']";
}

<===> 01_inline/output.css
.result {
  output: "[" ",foo   ,   " "]" "bar";
  output: [ ,foo   ,    ] bar;
  output: "[[ ,foo   ,    ] bar]";
  output: "[ ,foo   ,    ] bar";
  output: "[ ,foo   ,    ] bar";
  output: "['[ ,foo   ,    ] bar']";
}
