<===> mixin/input.scss
@mixin prepend-foo {
  $parent: &;

  @if $parent {
    .foo & {
      @content;
    }
  } @else {
    .foo {
      @content;
    }
  }
}

@include prepend-foo {
  bar {
    color: red;
  }
}

bar {
  @include prepend-foo {
    baz {
      color: red;
    }
  }
}

<===> mixin/output.css
.foo bar {
  color: red;
}

.foo bar baz {
  color: red;
}
