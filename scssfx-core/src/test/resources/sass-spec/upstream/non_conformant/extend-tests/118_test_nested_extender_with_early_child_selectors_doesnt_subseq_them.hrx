<===> 118_test_nested_extender_with_early_child_selectors_doesnt_subseq_them/input.scss
.bip > .bap .foo {a: b}
.grip > .bap .bar {@extend .foo}

<===> 118_test_nested_extender_with_early_child_selectors_doesnt_subseq_them/output.css
.bip > .bap .foo, .bip > .bap .grip > .bap .bar, .grip > .bap .bip > .bap .bar {
  a: b;
}
