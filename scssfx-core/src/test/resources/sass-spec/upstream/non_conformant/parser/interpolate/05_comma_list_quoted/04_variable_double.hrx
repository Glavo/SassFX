<===> 04_variable_double/input.scss
$input: "alpha", 'beta';
.result {
  output: #{#{$input}};
  output: #{"[#{$input}]"};
  output: #{"#{$input}"};
  output: #{'#{$input}'};
  output: #{"['#{$input}']"};
}

<===> 04_variable_double/output.css
.result {
  output: alpha, beta;
  output: [alpha, beta];
  output: alpha, beta;
  output: alpha, beta;
  output: ['alpha, beta'];
}
