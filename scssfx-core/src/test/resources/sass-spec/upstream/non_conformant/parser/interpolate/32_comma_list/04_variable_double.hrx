<===> 04_variable_double/input.scss
$input: "["',foo,   '"]";
.result {
  output: #{#{$input}};
  output: #{"[#{$input}]"};
  output: #{"#{$input}"};
  output: #{'#{$input}'};
  output: #{"['#{$input}']"};
}

<===> 04_variable_double/output.css
.result {
  output: [ ,foo,    ];
  output: [[ ,foo,    ]];
  output: [ ,foo,    ];
  output: [ ,foo,    ];
  output: ['[ ,foo,    ]'];
}
