<===> issue_2959/input.scss
%color {
	color: blue;
}

@mixin getOverridedSelector {
	&#{&} {
		@content;
	}
}

.foo {
	@include getOverridedSelector {
		@extend %color;
	}
}

.bar {
	@include getOverridedSelector {
		color: red;
	}
}

<===> issue_2959/output.css
.foo.foo {
  color: blue;
}

.bar.bar {
  color: red;
}
