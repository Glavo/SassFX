.button {
  color: theme.$palette-color;
}
<===> modules/forward-prefix/_facade.scss
@forward "tokens" as palette-*;
<===> modules/forward-prefix/_tokens.scss
$color: #c30;
<===> modules/forward-prefix/output.css
