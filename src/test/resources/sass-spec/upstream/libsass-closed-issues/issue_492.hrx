<===> issue_492/input.scss
$map: (
  foo: bar,
  baz: monkey,
);

.css {
  @each $key, $value in $map {
    #{$key}: $value;
  }
}

$list: one two, three four five, six seven;

.list {
  @each $foo, $bar, $baz in $list {
    #{$foo}: $bar $baz;
  }
}

<===> issue_492/output.css
.css {
  foo: bar;
  baz: monkey;
}

.list {
  one: two;
  three: four five;
  six: seven;
}
