<===> issue_224/input.scss
@use "sass:list";
$list: ("a", "b", "c");

test {
    content: list.nth($list, -1);
    content: list.nth($list, -2);
    content: list.nth($list, -3);
    content: list.nth($list, -1) == list.nth($list, list.length($list));
}

<===> issue_224/output.css
test {
  content: "c";
  content: "b";
  content: "a";
  content: true;
}
