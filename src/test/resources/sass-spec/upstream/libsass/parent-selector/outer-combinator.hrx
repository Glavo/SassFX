<===> outer-combinator/input.scss
foo bar {
    & baz {
        bam: true;
    }
    baz & {
        bam: true;
    }
}

foo + bar {
    & baz {
        bam: true;
    }
    baz & {
        bam: true;
    }
}

foo > bar {
    & baz {
        bam: true;
    }
    baz & {
        bam: true;
    }
}

foo ~ bar {
    & baz {
        bam: true;
    }
    baz & {
        bam: true;
    }
}

<===> outer-combinator/output.css
foo bar baz {
  bam: true;
}
baz foo bar {
  bam: true;
}

foo + bar baz {
  bam: true;
}
baz foo + bar {
  bam: true;
}

foo > bar baz {
  bam: true;
}
baz foo > bar {
  bam: true;
}

foo ~ bar baz {
  bam: true;
}
baz foo ~ bar {
  bam: true;
}
