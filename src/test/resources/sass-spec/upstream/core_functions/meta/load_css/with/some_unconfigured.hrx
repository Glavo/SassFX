<===> some_unconfigured/input.scss
@use "sass:meta";
@include meta.load-css("other", $with: (a: configured a));

<===> some_unconfigured/_other.scss
$a: original a !default;
$b: original b !default;

c {
  a: $a;
  b: $b;
}

<===> some_unconfigured/output.css
c {
  a: configured a;
  b: original b;
}
