<===> multiple/input.scss
@use "other" with (
  $a: configured a,
  $b: configured b,
  $c: configured c
);

<===> multiple/_other.scss
$a: original a !default;
$b: original b !default;
$c: original c !default;

d {
  a: $a;
  b: $b;
  c: $c;
}

<===> multiple/output.css
d {
  a: configured a;
  b: configured b;
  c: configured c;
}
