<===> 130_test_random_directive_interpolation/input.scss
$domain: "sass-lang.com";
@foo url(https://#{$domain}/),
     #{domain($domain)},
     "foo#{'ba' + 'r'}baz",
     foo#{'ba' + 'r'}baz {
  .foo {a: b}
}

<===> 130_test_random_directive_interpolation/output.css
@foo url(https://sass-lang.com/),
     domain("sass-lang.com"),
     "foobarbaz",
     foobarbaz {
  .foo {
    a: b;
  }
}
