<===> 02_variable/input.scss
$input: "foo#{'ba' + 'r'}baz";
.result {
  output: $input;
  output: #{$input};
  output: "[#{$input}]";
  output: "#{$input}";
  output: '#{$input}';
  output: "['#{$input}']";
}

<===> 02_variable/output.css
.result {
  output: "foobarbaz";
  output: foobarbaz;
  output: "[foobarbaz]";
  output: "foobarbaz";
  output: "foobarbaz";
  output: "['foobarbaz']";
}
