<===> 04_variable_double/input.scss
$input: "["'foo   '"]"    "bar";
.result {
  output: #{#{$input}};
  output: #{"[#{$input}]"};
  output: #{"#{$input}"};
  output: #{'#{$input}'};
  output: #{"['#{$input}']"};
}

<===> 04_variable_double/output.css
.result {
  output: [ foo    ] bar;
  output: [[ foo    ] bar];
  output: [ foo    ] bar;
  output: [ foo    ] bar;
  output: ['[ foo    ] bar'];
}
