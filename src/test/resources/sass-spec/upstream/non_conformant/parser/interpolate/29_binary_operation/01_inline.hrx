<===> 01_inline/input.scss
.result {
  output: "foo#{'ba' + 'r'}baz";
  output: #{"foo#{'ba' + 'r'}baz"};
  output: "[#{"foo#{'ba' + 'r'}baz"}]";
  output: "#{"foo#{'ba' + 'r'}baz"}";
  output: '#{"foo#{'ba' + 'r'}baz"}';
  output: "['#{"foo#{'ba' + 'r'}baz"}']";
}

<===> 01_inline/output.css
.result {
  output: "foobarbaz";
  output: foobarbaz;
  output: "[foobarbaz]";
  output: "foobarbaz";
  output: "foobarbaz";
  output: "['foobarbaz']";
}
