<===> 04_variable_double/input.scss
$input: 'l\\ite\ral';
.result {
  output: #{#{$input}};
  output: #{"[#{$input}]"};
  output: #{"#{$input}"};
  output: #{'#{$input}'};
  output: #{"['#{$input}']"};
}

<===> 04_variable_double/output.css
.result {
  output: l\iteral;
  output: [l\iteral];
  output: l\iteral;
  output: l\iteral;
  output: ['l\iteral'];
}
