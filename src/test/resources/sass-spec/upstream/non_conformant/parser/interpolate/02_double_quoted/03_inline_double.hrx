<===> 03_inline_double/input.scss
.result {
  output: #{#{"dquoted"}};
  output: #{"[#{"dquoted"}]"};
  output: #{"#{"dquoted"}"};
  output: #{'#{"dquoted"}'};
  output: #{"['#{"dquoted"}']"};
}

<===> 03_inline_double/output.css
.result {
  output: dquoted;
  output: [dquoted];
  output: dquoted;
  output: dquoted;
  output: ['dquoted'];
}
