<===> 02_variable/input.scss
$input: "dquoted";
.result {
  output: $input;
  output: #{$input};
  output: "[#{$input}]";
  output: "#{$input}";
  output: '#{$input}';
  output: "['#{$input}']";
}

<===> 02_variable/output.css
.result {
  output: "dquoted";
  output: dquoted;
  output: "[dquoted]";
  output: "dquoted";
  output: "dquoted";
  output: "['dquoted']";
}
