<===> 02_variable/input.scss
$input: gamma, "'"delta"'";
.result {
  output: $input;
  output: #{$input};
  output: "[#{$input}]";
  output: "#{$input}";
  output: '#{$input}';
  output: "['#{$input}']";
}

<===> 02_variable/output.css
.result {
  output: gamma, "'" delta "'";
  output: gamma, ' delta ';
  output: "[gamma, ' delta ']";
  output: "gamma, ' delta '";
  output: "gamma, ' delta '";
  output: "['gamma, ' delta '']";
}
