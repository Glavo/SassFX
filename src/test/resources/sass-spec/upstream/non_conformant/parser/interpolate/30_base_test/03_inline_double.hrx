<===> 03_inline_double/input.scss
.result {
  output: #{#{"foo#{'ba' + 'r'}baz"}};
  output: #{"[#{"foo#{'ba' + 'r'}baz"}]"};
  output: #{"#{"foo#{'ba' + 'r'}baz"}"};
  output: #{'#{"foo#{'ba' + 'r'}baz"}'};
  output: #{"['#{"foo#{'ba' + 'r'}baz"}']"};
}

<===> 03_inline_double/output.css
.result {
  output: foobarbaz;
  output: [foobarbaz];
  output: foobarbaz;
  output: foobarbaz;
  output: ['foobarbaz'];
}
