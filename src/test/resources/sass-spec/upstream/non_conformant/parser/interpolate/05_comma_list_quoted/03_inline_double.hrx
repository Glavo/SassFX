<===> 03_inline_double/input.scss
.result {
  output: #{#{"alpha", 'beta'}};
  output: #{"[#{"alpha", 'beta'}]"};
  output: #{"#{"alpha", 'beta'}"};
  output: #{'#{"alpha", 'beta'}'};
  output: #{"['#{"alpha", 'beta'}']"};
}

<===> 03_inline_double/output.css
.result {
  output: alpha, beta;
  output: [alpha, beta];
  output: alpha, beta;
  output: alpha, beta;
  output: ['alpha, beta'];
}
