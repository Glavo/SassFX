<===> 04_variable_double/input.scss
$input: gamme "'"delta"'";
.result {
  output: #{#{$input}};
  output: #{"[#{$input}]"};
  output: #{"#{$input}"};
  output: #{'#{$input}'};
  output: #{"['#{$input}']"};
}

<===> 04_variable_double/output.css
.result {
  output: gamme ' delta ';
  output: [gamme ' delta '];
  output: gamme ' delta ';
  output: gamme ' delta ';
  output: ['gamme ' delta ''];
}
