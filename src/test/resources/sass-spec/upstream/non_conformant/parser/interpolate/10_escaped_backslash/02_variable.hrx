<===> 02_variable/input.scss
$input: \\;
.result {
  output: $input;
  output: #{$input};
  output: "[#{$input}]";
  output: "#{$input}";
  output: '#{$input}';
  output: "['#{$input}']";
}

<===> 02_variable/output.css
.result {
  output: \\;
  output: \\;
  output: "[\\\\]";
  output: "\\\\";
  output: "\\\\";
  output: "['\\\\']";
}
