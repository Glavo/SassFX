<===> 02_variable/input.scss
$input: "["',foo,   '"]";
.result {
  output: $input;
  output: #{$input};
  output: "[#{$input}]";
  output: "#{$input}";
  output: '#{$input}';
  output: "['#{$input}']";
}

<===> 02_variable/output.css
.result {
  output: "[" ",foo,   " "]";
  output: [ ,foo,    ];
  output: "[[ ,foo,    ]]";
  output: "[ ,foo,    ]";
  output: "[ ,foo,    ]";
  output: "['[ ,foo,    ]']";
}
