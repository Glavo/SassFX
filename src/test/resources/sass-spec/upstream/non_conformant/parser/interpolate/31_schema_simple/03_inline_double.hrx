<===> 03_inline_double/input.scss
.result {
  output: #{#{"["'foo'"]"}};
  output: #{"[#{"["'foo'"]"}]"};
  output: #{"#{"["'foo'"]"}"};
  output: #{'#{"["'foo'"]"}'};
  output: #{"['#{"["'foo'"]"}']"};
}

<===> 03_inline_double/output.css
.result {
  output: [ foo ];
  output: [[ foo ]];
  output: [ foo ];
  output: [ foo ];
  output: ['[ foo ]'];
}
