<===> 102_test_nested_extender_unifies_common_subseq/input.scss
.a .x .b .y .foo {a: b}
.a .n .b .m bar {@extend .foo}

<===> 102_test_nested_extender_unifies_common_subseq/output.css
.a .x .b .y .foo, .a .x .n .b .y .m bar, .a .n .x .b .y .m bar, .a .x .n .b .m .y bar, .a .n .x .b .m .y bar {
  a: b;
}
