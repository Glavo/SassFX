<===> 184_test_control_flow_if/input.scss
.true  { color: green; }
.false { color: red;   }
.also-true {
@if true { @extend .true;  }
@else    { @extend .false; }
}
.also-false {
@if false { @extend .true;  }
@else     { @extend .false; }
}

<===> 184_test_control_flow_if/output.css
.true, .also-true {
  color: green;
}

.false, .also-false {
  color: red;
}
