<===> 09_selector_groups_and_combinators/input.scss
a + b, c {
  blah: blah;
  bleh: bleh;
  d e, f ~ g + h, > i {
    bloo: bloo;
    blee: blee;
  }
}
<===> 09_selector_groups_and_combinators/output.css
a + b, c {
  blah: blah;
  bleh: bleh;
}
a + b d e, a + b f ~ g + h, a + b > i, c d e, c f ~ g + h, c > i {
  bloo: bloo;
  blee: blee;
}
