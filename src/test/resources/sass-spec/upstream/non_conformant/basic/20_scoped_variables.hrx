<===> 20_scoped_variables/input.scss
@mixin foo() {
  /* begin foo */
  /* assigning to $x */
  $x: inside foo;
  x: $x;
  /* end foo */
}

outer {
  /* assigning to $x */
  $x: inside outer scope;
  blah: blah;
  inner {
    @include foo();
    x: $x;
  }
}
<===> 20_scoped_variables/output.css
outer {
  /* assigning to $x */
  blah: blah;
}
outer inner {
  /* begin foo */
  /* assigning to $x */
  x: inside foo;
  /* end foo */
  x: inside outer scope;
}
