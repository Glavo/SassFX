<===> 31_if_in_mixin/input.scss
$x: true;

@mixin foobar() {
  @if $x {
    $x: false !global;
    content: foo;
  }
  @else {
    $x: true !global;
    content: bar;
  }
}

div {
  @include foobar();
  @include foobar();
  @include foobar();
  $x: true !global;
  @include foobar();
}

<===> 31_if_in_mixin/output.css
div {
  content: foo;
  content: bar;
  content: foo;
  content: foo;
}
