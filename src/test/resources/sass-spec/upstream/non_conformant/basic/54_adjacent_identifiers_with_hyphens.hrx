<===> 54_adjacent_identifiers_with_hyphens/input.scss
input {
    outline: 5px auto -webkit-focus-ring-color;
    foo: random -hello-this-is-dog;
    bar: rando -two-or-more -things-that-start -with-hyphens;
    baz: foo - bar;
}
<===> 54_adjacent_identifiers_with_hyphens/output.css
input {
  outline: 5px auto -webkit-focus-ring-color;
  foo: random -hello-this-is-dog;
  bar: rando -two-or-more -things-that-start -with-hyphens;
  baz: foo-bar;
}
