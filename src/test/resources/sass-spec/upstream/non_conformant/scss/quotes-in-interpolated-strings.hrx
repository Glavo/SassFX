<===> quotes-in-interpolated-strings/input.scss
$bar: "bar";
$foobar: "foo#{$bar}";
#{$bar} {
  #{$bar}: #{$bar};
  #{$bar}: $bar;
}
foobar {
  #{$foobar}: #{$foobar};
  #{$foobar}: $foobar;
}
<===> quotes-in-interpolated-strings/output.css
bar {
  bar: bar;
  bar: "bar";
}

foobar {
  foobar: foobar;
  foobar: "foobar";
}
